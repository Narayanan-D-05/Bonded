{
  "name": "@bonded/intercepta-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Live Intercepta (Web3 Antivirus) HTTP client and resolvePremise adapter — Commerce Edition. No cache, ever, on this path (Migration PRD D.5).",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@bonded/seam": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
