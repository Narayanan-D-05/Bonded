{
  "name": "@bonded/issuer-oracle",
  "version": "1.0.0",
  "private": true,
  "description": "Disclosed, controlled reference oracle for item truth (ticket face value/status/seller-authorization, e-commerce listed price) — the one deliberately fixture-backed component in the Commerce Edition build. See src/tickets-fixture.ts and docs/THREATMODEL.md.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "xero:setup": "tsx scripts/xero-setup.ts",
    "xero:check": "tsx scripts/xero-live-check.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
