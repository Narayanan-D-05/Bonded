# Commerce Edition — Intercepta, Sui, World. Committed with NO real values.
# `.env` itself is never committed.
#
# CLAUDE.md rule 3: nothing that SIGNS on chain lives here in plaintext.
#  - Sui signing uses the Sui CLI keystore (~/.sui/sui_config/sui.keystore),
#    outside the repo; code never reads key bytes.

INTERCEPTA_API_KEY=

SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Public on-chain object ids from move/DEPLOYMENTS.md (Commerce Edition, testnet).
# These are ids, not secrets: @bonded/sui-settlement reads them and signs via
# the Sui CLI keystore, never from this file. Each is required; a missing one
# fails visibly, naming the variable.
SUI_BONDED_PACKAGE_ID=0xf3d914b39722e1c6c3f0e274d088623c0e050d3125b8f658d48b94498efbf57a
SUI_VAULT_ID=0x1c828f5496dfb9200c50f7fcc932cb0edb477265b58978036f4b77018e4dd433
SUI_REGISTRY_ID=0x107a77efbd5ab5ba91d4ec1104205e254a14365484d694ec72a615bea2b912a5
SUI_ENFORCER_CAP_ID=0x60302c2c5682c685daf794b1acf0114bbcfea1d5873066d2860654b1ea5f375d
# 6 decimals, same scale as USDC. Same testnet address as before; the vault
# itself is generic over the coin type.
SUI_BOND_COIN_TYPE=0x832f93729a8b1dfe9dd8067536dfa35231cf019f9401afe04a398df6d18c54cb::usdsui::USDSUI

WORLD_SANDBOX_CLIENT_ID=
WORLD_SANDBOX_CLIENT_SECRET=
WORLD_REDIRECT_URI=

# Vendor master source for @bonded/issuer-oracle: fixture (default) | xero.
# `xero` reads a real Xero org via a Custom Connection (client_credentials;
# free against the Xero Demo Company). Missing creds fail loudly; there is
# never a fallback to the fixture. One-time setup:
#   pnpm --filter @bonded/issuer-oracle xero:setup
VENDOR_MASTER_SOURCE=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional. The custom-connection guide sends no tenant header; Xero's OpenAPI
# spec marks it required. Set it only if calls fail without it.
XERO_TENANT_ID=
