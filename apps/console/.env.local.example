# apps/console — Commerce Edition env, following the repo's turbo.json globalEnv list.
# Committed with NO real values, matching the repo root's .env.example convention.
# `.env.local` itself is never committed (repo .gitignore line 20).
#
# CLAUDE.md rule 3: nothing that SIGNS on chain lives here in plaintext. This app never
# signs on chain (settlement stays a CLI/script demo — see the plan's explicit scope note),
# so this file is safe to hold sandbox client config, never a private key.

INTERCEPTA_API_KEY=

SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_BONDED_PACKAGE_ID=
SUI_BOND_COIN_TYPE=
NEXT_PUBLIC_SUI_NETWORK=testnet

# World ID for Agents sandbox — required for /stepup and /api/stepup to do anything real.
# Missing values fail visibly (named, never faked) rather than a silent skip. Register a
# confidential client at https://sandbox.auth.world.org/portal.
WORLD_SANDBOX_CLIENT_ID=
WORLD_SANDBOX_CLIENT_SECRET=
# Must be an https:// URL (the sandbox rejects http, including http://localhost); point it
# at this app's own /api/stepup route, e.g. via an HTTPS tunnel in local dev.
WORLD_REDIRECT_URI=
